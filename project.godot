; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Upward"
run/main_scene="uid://bwjypqfmpettn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/use_filter=false
boot_splash/image="uid://cq6wk715ju8co"
config/icon="uid://dx78aab6600bl"

[audio]

buses/default_bus_layout="res://main/default_bus_layout.tres"

[autoload]

GameManager="*res://globals/GameManager.gd"
DataManager="*res://globals/DataManager.gd"
AudioManager="*res://globals/AudioManager.gd"
StatisticManager="*res://globals/StatisticManager.gd"
GameHandler="*uid://dapkibmitjx82"
MenuHandler="*uid://boqav6yfiyrq2"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"
window/vsync/vsync_mode=0

[file_customization]

folder_colors={
"res://assets/": "green",
"res://globals/": "pink",
"res://main/": "red",
"res://maps/": "orange",
"res://prefabs/": "purple",
"res://ressources/": "blue",
"res://utility/": "blue"
}

